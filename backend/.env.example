# ==============================================================================
# Job Portal Backend Environment Configuration Template
# Copy this file to backend/.env:
#   cp .env.example .env
# ==============================================================================

PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=jobportal
DB_PASS=jobportal
DB_NAME=job_portal
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=10d
ADMIN_SECRET=admin-secret
BCRYPT_ROUNDS=10
UPLOADS_DIR=uploads
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Cloudinary media storage (all three required for CloudinaryImageStorage)
# If omitted or empty, backend falls back to LocalImageStorage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
