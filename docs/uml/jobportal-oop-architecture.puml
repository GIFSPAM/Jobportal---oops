' =====================================================================
'  7. STORAGE MODULE (Strategy pattern)
' =====================================================================
package "storage module" #FFF3E6 {

  abstract class ImageStorage <<abstract strategy>> {
    {abstract} +upload(buffer: Buffer, folder: string, originalName: string): Promise<string>
  }

  class LocalImageStorage <<strategy: disk>> {
    -rootDir : string
    +upload(buffer, folder, originalName): Promise<string>
  }

  class CloudinaryImageStorage <<strategy: CDN>> {
    -cloudinary : Cloudinary
    +upload(buffer, folder, originalName): Promise<string>
  }

  class ResumeStorageService <<@Injectable>> {
    +save(buffer, originalName?): StoredFile
    +resolve(storedPath): string
    +downloadName(storedPath, fallback): string
    +stream(absolutePath, filename, response): Promise<void>
  }

  class ResumeDownloadController <<@Controller('resume-download')>> {
    +download(applicationId, user, response): Promise<void>
  }

  ImageStorage <|-- LocalImageStorage
  ImageStorage <|-- CloudinaryImageStorage
}

ResumeDownloadController ..> ResumeStorageService
SeekerProfileService ..> ResumeStorageService : «resume upload»
ResumeDownloadController ..> Application : «authorisation»
note bottom of ImageStorage
  **Strategy pattern.** Abstract factory provider in
  storage.module.ts selects the concrete implementation
  (local disk or Cloudinary) from configuration and
  injects it into profile services.
end note

