' =====================================================================
'  1. NESTJS FRAMEWORK CONTRACTS (implemented, not owned)
' =====================================================================
package "NestJS contracts (framework)" #EEEEEE {
  interface "CanActivate" as CanActivate {
    +canActivate(context: ExecutionContext): boolean | Promise<boolean>
  }
  interface "NestInterceptor" as NestInterceptor {
    +intercept(ctx: ExecutionContext, next: CallHandler): Observable<any>
  }
  interface "ExceptionFilter" as ExceptionFilter {
    +catch(exception: unknown, host: ArgumentsHost): void
  }
  abstract class "HttpException" as NestHttpException {
    +getStatus(): number
    +getResponse(): string | object
  }
}

' =====================================================================
'  2. CROSS-CUTTING: GUARDS / INTERCEPTOR / FILTER / ERRORS
' =====================================================================
package "Cross-cutting concerns" #F5EEF8 {

  class JwtAuthGuard <<@Injectable, global>> {
    -reflector : Reflector
    -sessions : SessionService
    +canActivate(context): Promise<boolean>
    -extractBearerToken(header?: string): string | null
  }

  class RolesGuard <<@Injectable, global>> {
    -reflector : Reflector
    +canActivate(context): boolean
  }

  class ResponseEnvelopeInterceptor <<@Injectable, global>> {
    +intercept(ctx, next): Observable<Envelope>
    -envelop(value: unknown): Envelope
  }

  class HttpExceptionFilter <<@Catch()>> {
    -logger : Logger
    +catch(exception, host): void
    -toPayload(exception): {status, message}
    -toText(...candidates: unknown[]): string
  }

  class BadRequestError
  class UnauthorizedError
  class ForbiddenError
  class NotFoundError
  class ConflictError
  class UnprocessableError

  NestHttpException <|-- BadRequestError
  NestHttpException <|-- UnauthorizedError
  NestHttpException <|-- ForbiddenError
  NestHttpException <|-- NotFoundError
  NestHttpException <|-- ConflictError
  NestHttpException <|-- UnprocessableError

  class ApiResult<T> <<response envelope>> {
    -data : T | undefined
    -options : EnvelopeOptions
    -ApiResult(data, options)
    +{static} withData<T>(data, options): ApiResult<T>
    +{static} withMessage(message): ApiResult<never>
    +{static} withCount<T>(data, count, options): ApiResult<T>
  }

  interface Envelope<T> <<DTO contract>> {
    +success : true {readonly}
    +message? : string {readonly}
    +data? : T {readonly}
    +count? : number {readonly}
  }

  interface AuthenticatedUser <<value object>> {
    +userId : number {readonly}
    +role : UserRole {readonly}
    +email : string {readonly}
  }
}

JwtAuthGuard ..|> CanActivate
RolesGuard ..|> CanActivate
ResponseEnvelopeInterceptor ..|> NestInterceptor
HttpExceptionFilter ..|> ExceptionFilter
ResponseEnvelopeInterceptor ..> ApiResult : «maps»
ResponseEnvelopeInterceptor ..> Envelope : «produces»
JwtAuthGuard ..> SessionService : «resolves identity»
RolesGuard ..> AuthenticatedUser : «reads role»

' =====================================================================
'  3. AUTH MODULE
' =====================================================================
package "auth module" #EAF3FF {

  class AuthController <<@Controller('auth')>> {
    +register(dto: RegisterDto): Promise<ApiResult<AuthResponse>>
    +login(dto: LoginDto): Promise<ApiResult<AuthResponse>>
  }

  class AuthService <<@Injectable>> {
    -logger : Logger
    -users : Repository<User>
    -dataSource : DataSource
    -jwtService : JwtService
    -config : ConfigService
    +register(dto: RegisterDto): ApiResult<AuthResponse>
    +login(dto: LoginDto): ApiResult<AuthResponse>
    +signToken(user: User): Promise<string>
    -toResponse(user: User): Promise<AuthResponse>
    -assertRoleRequirements(dto: RegisterDto): void
    -isDuplicateKeyError(error: unknown): boolean
  }

  class SessionService <<@Injectable>> {
    +resolve(token: string): Promise<AuthenticatedUser>
  }

  interface RegisterDto <<DTO, validation>> {
    +email : string
    +password : string
    +role : UserRole
    +secretKey? : string
    +full_name? : string
    +company_name? : string
    +education? : string
    +experience_years? : number
  }

  interface LoginDto <<DTO, validation>> {
    +email : string
    +password : string
  }

  function toAuthResponse <<mapper>> (user: User, token: string): AuthResponse
}

AuthController ..> AuthService : «delegates»
AuthController ..> RegisterDto : «binds»
AuthController ..> LoginDto : «binds»
AuthService ..> User : «Repository CRUD»
AuthService ..> JobSeeker : «insert on register»
AuthService ..> Employer : «insert on register»
AuthService ..> ApiResult : «wraps»
AuthService ..> toAuthResponse : «maps»

