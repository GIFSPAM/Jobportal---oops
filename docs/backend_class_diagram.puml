@startuml JobPortal_Backend_UML

' ═══════════════════════════════════════════════════════════
'  Job Portal Management System — Backend UML Class Diagram
' ═══════════════════════════════════════════════════════════
'  RELATIONSHIP LEGEND:
'    --|>    Generalization  (extends / inherits)
'    ..|>    Realization     (implements interface / abstract)
'    *--     Composition     (strong ownership, child dies with parent)
'    o--     Aggregation     (weak ownership, child can exist alone)
'    -->     Directed Association
'    ..>     Dependency      (uses)
' ═══════════════════════════════════════════════════════════

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classFontName "Segoe UI"
skinparam packageFontSize 14
skinparam packageFontStyle bold
skinparam shadowing false
skinparam roundcorner 8
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #555555
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #888888
}
skinparam nodesep 40
skinparam ranksep 35

title **Job Portal Management System — Backend Core Logic UML Class Diagram**\n<size:11>Standard UML Notation • Composition • Aggregation • Association • Generalization • Realization</size>

' ═══════════════════════════════════
'          ENUMERATIONS
' ═══════════════════════════════════

package "Enumerations" <<Rectangle>> #F0FFF0 {

  enum UserRole <<enum>> #D5E8D4 {
    JOBSEEKER
    EMPLOYER
    ADMIN
  }

  enum JobType <<enum>> #D5E8D4 {
    FULL_TIME
    PART_TIME
    INTERNSHIP
  }

  enum JobStatus <<enum>> #D5E8D4 {
    OPEN
    CLOSED
  }

  enum ApplicationStatus <<enum>> #D5E8D4 {
    APPLIED
    SHORTLISTED
    REJECTED
    HIRED
  }

  enum SkillProficiency <<enum>> #D5E8D4 {
    BEGINNER
    INTERMEDIATE
    ADVANCED
  }

  enum CompanySize <<enum>> #D5E8D4 {
    SIZE_1_10
    SIZE_11_50
    SIZE_51_200
    SIZE_201_500
    SIZE_500_PLUS
  }
}

' ═══════════════════════════════════
'          INTERFACES
' ═══════════════════════════════════

package "Interfaces & Contracts" <<Rectangle>> #F0F0FF {

  interface Envelope <T> <<interface>> #DAE8FC {
    + success : boolean
    + message? : string
    + data? : T
    + count? : number
  }

  interface AuthenticatedUser <<interface>> #DAE8FC {
    + userId : number
    + role : UserRole
    + email : string
  }

  interface CanActivate <<interface>> #DAE8FC {
    + canActivate(ctx: ExecutionContext) : boolean
  }

  interface ExceptionFilter <<interface>> #DAE8FC {
    + catch(exception: unknown, host: ArgumentsHost) : void
  }

  interface NestInterceptor <<interface>> #DAE8FC {
    + intercept(ctx: ExecutionContext, next: CallHandler) : Observable
  }

  class "ApiResult<T>" as ApiResult #E1D5E7 {
    - data : T | undefined
    - options : EnvelopeOptions
    __
    - ApiResult(data, options)
    + {static} withData(data, opts?) : ApiResult<T>
    + {static} withMessage(msg) : ApiResult<never>
    + {static} withCount(data, count, opts?) : ApiResult<T>
  }
}

' ═══════════════════════════════════
'     EXCEPTION HIERARCHY
'     (Generalization --|>)
' ═══════════════════════════════════

package "Domain Exceptions  «Generalization»" <<Rectangle>> #FFF8E1 {

  class HttpException <<NestJS>> #FFE0B2 {
    + getStatus() : number
    + getResponse() : string | object
  }

  class BadRequestError #FFF3E0 {
    + constructor(message?, details?)
  }

  class UnauthorizedError #FFF3E0 {
    + constructor(message?)
  }

  class ForbiddenError #FFF3E0 {
    + constructor(message?)
  }

  class NotFoundError #FFF3E0 {
    + constructor(message?)
  }

  class ConflictError #FFF3E0 {
    + constructor(message?)
  }

  class UnprocessableError #FFF3E0 {
    + constructor(message?, details?)
  }

  BadRequestError --|> HttpException : extends
  UnauthorizedError --|> HttpException : extends
  ForbiddenError --|> HttpException : extends
  NotFoundError --|> HttpException : extends
  ConflictError --|> HttpException : extends
  UnprocessableError --|> HttpException : extends
}

' ═══════════════════════════════════
'        ENTITY LAYER
'  (Composition, Aggregation, Assoc)
' ═══════════════════════════════════

package "Entity Layer  «Composition · Aggregation · Association»" <<Rectangle>> #FFF5F5 {

  class User <<Entity>> #F8CECC {
    + userId : number «PK»
    + email : string
    + passwordHash : string
    + role : UserRole
    + isActive : boolean
    + createdAt : Date
    __
    + seeker? : JobSeeker
    + employer? : Employer
    + adminLogs? : AdminLog[]
  }

  class Employer <<Entity>> #F8CECC {
    + employerId : number «PK/FK»
    + companyName : string | null
    + companyPhone : string | null
    + industry : string | null
    + companySize : CompanySize | null
    + companyLocation : string | null
    + companyWebsite : string | null
    + profilePictureUrl : string | null
    __
    + user : User
    + jobs? : Job[]
  }

  class JobSeeker <<Entity>> #F8CECC {
    + seekerId : number «PK/FK»
    + fullName : string | null
    + phoneNumber : string | null
    + education : string | null
    + experienceYears : number | null
    + resumePath : string | null
    + resumeFilename : string | null
    + profilePictureUrl : string | null
    __
    + user : User
    + seekerSkills? : SeekerSkill[]
    + applications? : Application[]
    + savedJobs? : SavedJob[]
  }

  class Job <<Entity>> #F8CECC {
    + jobId : number «PK»
    + employerId : number «FK»
    + title : string | null
    + description : string | null
    + location : string | null
    + jobType : JobType | null
    + salaryMin : number | null
    + salaryMax : number | null
    + applicationCount : number
    + status : JobStatus
    + isVerified : boolean
    + verifiedBy : number | null
    + verifiedAt : Date | null
    + postedAt : Date
    __
    + employer : Employer
    + jobSkills? : JobSkill[]
    + applications? : Application[]
    + savedBy? : SavedJob[]
  }

  class Application <<Entity>> #F8CECC {
    + applicationId : number «PK»
    + jobId : number «FK»
    + seekerId : number «FK»
    + status : ApplicationStatus
    + appliedAt : Date
    __
    + job : Job
    + seeker : JobSeeker
  }

  class Skill <<Entity>> #F8CECC {
    + skillId : number «PK»
    + skillName : string
    __
    + jobSkills? : JobSkill[]
    + seekerSkills? : SeekerSkill[]
  }

  class JobSkill <<Entity>> #F8CECC {
    + jobId : number «PK/FK»
    + skillId : number «PK/FK»
    __
    + job : Job
    + skill : Skill
  }

  class SeekerSkill <<Entity>> #F8CECC {
    + seekerId : number «PK/FK»
    + skillId : number «PK/FK»
    + proficiency : SkillProficiency
    __
    + seeker : JobSeeker
    + skill : Skill
  }

  class SavedJob <<Entity>> #F8CECC {
    + seekerId : number «PK/FK»
    + jobId : number «PK/FK»
    + savedAt : Date
    __
    + seeker : JobSeeker
    + job : Job
  }

  class AdminLog <<Entity>> #F8CECC {
    + logId : number «PK»
    + adminId : number «FK»
    + actionType : string | null
    + targetTable : string | null
    + targetId : number | null
    + actionTime : Date
    __
    + admin : User
  }

  ' ── COMPOSITION (◆): child cannot exist without parent, CASCADE DELETE ──
  User "1" *-right- "0..1" Employer : «Composition»\nshared PK\nonDelete CASCADE
  User "1" *-left- "0..1" JobSeeker : «Composition»\nshared PK\nonDelete CASCADE
  User "1" *-- "0..*" AdminLog : «Composition»\nonDelete CASCADE

  Employer "1" *-- "0..*" Job : «Composition»\nonDelete CASCADE

  Job "1" *-- "0..*" Application : «Composition»\nonDelete CASCADE
  Job "1" *-- "0..*" JobSkill : «Composition»\nonDelete CASCADE
  Job "1" *-- "0..*" SavedJob : «Composition»\nonDelete CASCADE

  JobSeeker "1" *-- "0..*" Application : «Composition»\nonDelete CASCADE
  JobSeeker "1" *-- "0..*" SeekerSkill : «Composition»\ncascade: true
  JobSeeker "1" *-- "0..*" SavedJob : «Composition»\nonDelete CASCADE

  ' ── AGGREGATION (◇): Skill is a shared reference, lives independently ──
  Skill "1" o-- "0..*" JobSkill : «Aggregation»\nshared ref
  Skill "1" o-- "0..*" SeekerSkill : «Aggregation»\nshared ref
}

' ═══════════════════════════════════
'     GUARDS  «Realization»
' ═══════════════════════════════════

package "Guards  «Realization of CanActivate»" <<Rectangle>> #E3F2FD {

  class JwtAuthGuard <<Guard>> #BBDEFB {
    - reflector : Reflector
    - sessions : SessionService
    + constructor(reflector, sessions)
    + canActivate(ctx) : Promise<boolean>
    - extractBearerToken(header?) : string | null
  }

  class RolesGuard <<Guard>> #BBDEFB {
    - reflector : Reflector
    + constructor(reflector)
    + canActivate(ctx) : boolean
  }

  JwtAuthGuard ..|> CanActivate : «realizes»
  RolesGuard ..|> CanActivate : «realizes»
}

' ═══════════════════════════════════
'   FILTER & INTERCEPTOR «Realization»
' ═══════════════════════════════════

package "Cross-Cutting Concerns  «Realization»" <<Rectangle>> #F3E5F5 {

  class HttpExceptionFilter <<Filter>> #E1BEE7 {
    - logger : Logger
    + catch(exception, host) : void
    - toPayload(exception) : {status, message}
    - toText(...candidates) : string
  }

  class ResponseEnvelopeInterceptor <<Interceptor>> #E1BEE7 {
    + intercept(ctx, next) : Observable<Envelope>
    - envelop(value) : Envelope
  }

  HttpExceptionFilter ..|> ExceptionFilter : «realizes»
  ResponseEnvelopeInterceptor ..|> NestInterceptor : «realizes»
}

' ═══════════════════════════════════
'  STORAGE «Abstract + Realization»
' ═══════════════════════════════════

package "Storage Layer  «Abstract · Realization»" <<Rectangle>> #FFFDE7 {

  abstract class ImageStorage <<abstract>> #FFF9C4 {
    + {abstract} upload(buffer, folder, name) : Promise<string>
  }

  class CloudinaryImageStorage #FFF9C4 {
    + constructor(credentials: CloudinaryCredentials)
    + upload(buffer, folder, name) : Promise<string>
  }

  class LocalImageStorage #FFF9C4 {
    - rootDirectory : string
    + constructor(rootDirectory)
    + upload(buffer, folder, name) : Promise<string>
    - sanitize(folder) : string
  }

  class ResumeStorage #FFF9C4 {
    - directory : string
    + constructor(directory)
    + save(buffer, originalName?) : StoredFile
    + resolve(storedPath) : string
    + downloadName(storedPath, fallback) : string
    + stream(absPath, filename, response) : Promise<void>
  }

  CloudinaryImageStorage ..|> ImageStorage : «realizes»
  LocalImageStorage ..|> ImageStorage : «realizes»
}

