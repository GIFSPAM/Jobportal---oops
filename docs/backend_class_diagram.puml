' ═══════════════════════════════════

package "Auth Module" <<Rectangle>> #EDE7F6 {

  class AuthController <<Controller>> #D1C4E9 {
    - authService : AuthService
    + register(dto: RegisterDto) : Promise<ApiResult>
    + login(dto: LoginDto) : Promise<ApiResult>
  }

  class AuthService <<Service>> #D1C4E9 {
    - logger : Logger
    - users : Repository<User>
    - dataSource : DataSource
    - jwtService : JwtService
    - config : ConfigService
    + register(dto: RegisterDto) : Promise<ApiResult>
    + login(dto: LoginDto) : Promise<ApiResult>
    + signToken(user: User) : Promise<string>
    - toResponse(user) : Promise<AuthResponse>
    - assertRoleRequirements(dto) : void
    - isDuplicateKeyError(error) : boolean
  }

  class SessionService <<Service>> #D1C4E9 {
    - users : Repository<User>
    - jwtService : JwtService
    + resolve(token: string) : Promise<AuthenticatedUser>
  }

  AuthController --> AuthService : «association»
  JwtAuthGuard --> SessionService : «association»\nresolves tokens
}

