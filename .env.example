# ==============================================================================
# Job Portal (OOP) — Global Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# MariaDB Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=jobportal
DB_PASS=jobportal
DB_NAME=job_portal

# Docker Compose MariaDB Environment
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=job_portal
MARIADB_USER=jobportal
MARIADB_PASSWORD=jobportal

# ------------------------------------------------------------------------------
# Backend API & Authentication
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=10d
ADMIN_SECRET=admin-secret
BCRYPT_ROUNDS=10
UPLOADS_DIR=uploads
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Optional — leaves empty for local disk storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Frontend / Reverse Proxy
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:5000/api
